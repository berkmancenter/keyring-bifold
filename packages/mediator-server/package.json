{
  "name": "@bifold/mediator-server",
  "version": "1.0.0",
  "private": true,
  "description": "A local DIDComm mediator so a developer can run Keyring without shared infrastructure",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/index.ts",
    "start:prod": "node dist/index.js",
    "start:fresh": "yarn fresh && yarn start",
    "dev": "ts-node-dev --respawn src/index.ts",
    "fresh": "ts-node src/cleanWallet.ts",
    "verify": "ts-node src/verifyMediation.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@credo-ts/askar": "0.7.1-pr-2704-20260909134930",
    "@credo-ts/core": "patch:@credo-ts/core@npm%3A0.7.1-pr-2704-20260909134930#~/.yarn/patches/@credo-ts-core-npm-0.7.1-pr-2704-20260909134930-b95d84ab27.patch",
    "@credo-ts/didcomm": "patch:@credo-ts/didcomm@npm%3A0.7.1-pr-2704-20260909134930#~/.yarn/patches/@credo-ts-didcomm-npm-0.7.1-pr-2704-20260909134930-b4e8afd4d1.patch",
    "@credo-ts/node": "0.7.1-pr-2704-20260909134930",
    "@openwallet-foundation/askar-nodejs": "0.6.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.30",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
