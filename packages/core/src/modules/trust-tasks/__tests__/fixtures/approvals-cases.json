[
  { "name": "no rules: an abstaining module", "rules": [] },
  {
    "name": "one reauth rule",
    "rules": [{ "taskType": "https://trusttasks.org/spec/acl/grant/0.1", "requires": "reauth" }]
  },
  {
    "name": "one consent rule, defaults",
    "rules": [
      { "taskType": "https://trusttasks.org/spec/vta/contexts/create/1.0", "requires": "consent", "approverSet": "ops" }
    ]
  },
  {
    "name": "consent with every field",
    "rules": [
      {
        "taskType": "https://trusttasks.org/spec/vta/webvh/dids/update/1.0",
        "requires": "consent",
        "approverSet": "ops",
        "minApprovals": 2,
        "excludeRequester": true
      }
    ]
  },
  {
    "name": "minApprovals 0 is floored at 1",
    "rules": [
      {
        "taskType": "https://trusttasks.org/spec/vta/contexts/delete/1.0",
        "requires": "consent",
        "approverSet": "ops",
        "minApprovals": 0
      }
    ]
  },
  {
    "name": "scoped to contexts",
    "rules": [
      {
        "taskType": "https://trusttasks.org/spec/keys/revoke/0.1",
        "requires": "consent",
        "approverSet": "ops",
        "contexts": ["openvtc", "default"]
      },
      { "taskType": "https://trusttasks.org/spec/acl/grant/0.1", "requires": "reauth", "contexts": ["openvtc"] }
    ]
  },
  {
    "name": "several rules keep their order",
    "rules": [
      {
        "taskType": "https://trusttasks.org/spec/vta/webvh/dids/delete/1.0",
        "requires": "consent",
        "approverSet": "b"
      },
      { "taskType": "https://trusttasks.org/spec/vta/contexts/create/1.0", "requires": "consent", "approverSet": "a" },
      { "taskType": "https://trusttasks.org/spec/acl/grant/0.1", "requires": "reauth" }
    ]
  },
  {
    "name": "quotes, backslashes and control characters are escaped",
    "rules": [
      {
        "taskType": "https://trusttasks.org/spec/vta/contexts/create/1.0",
        "requires": "consent",
        "approverSet": "x\", \"decision\": \"allow\\\n\r\t",
        "contexts": ["a\"b", "c\\d"]
      }
    ]
  },
  {
    "name": "non-ASCII is kept as is",
    "rules": [
      {
        "taskType": "https://trusttasks.org/spec/vta/contexts/create/1.0",
        "requires": "consent",
        "approverSet": "téléphone",
        "contexts": ["café ☕"]
      }
    ]
  },
  {
    "name": "what Keyring's screen writes: this phone approves creating a context",
    "rules": [
      {
        "taskType": "https://trusttasks.org/spec/vta/contexts/create/1.0",
        "requires": "consent",
        "approverSet": "keyring-this-phone",
        "minApprovals": 1,
        "excludeRequester": false
      }
    ]
  }
]
