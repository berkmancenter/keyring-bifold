{
  // The ratchet's project (scripts/tsc-ratchet.mjs): core's tsconfig with the test files added back.
  // "exclude" replaces tsconfig.json's list rather than extending it, so an exclusion added there
  // must be mirrored here, or the ratchet keeps checking that path and blames the next PR.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "exclude": ["node_modules", "babel.config.js", "jest.config.js", "jestSetup.js", "lib", "build", "scripts"]
}
