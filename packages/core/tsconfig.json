{
  "extends": "../../tsconfig-base.json",
  "compilerOptions": {
    "baseUrl": "src",
    "outDir": "./lib",
    "paths": {
      "@openvtc/trust-tasks": [
        "../node_modules/@openvtc/trust-tasks/dist/index.d.ts"
      ],
      "@openvtc/trust-tasks/*": [
        "../node_modules/@openvtc/trust-tasks/dist/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "babel.config.js",
    "jest.config.js",
    "jestSetup.js",
    "lib",
    "build",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
