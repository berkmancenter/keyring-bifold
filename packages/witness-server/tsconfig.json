{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": [
      "ES2020"
    ],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@openvtc/trust-tasks": [
        "../../node_modules/@openvtc/trust-tasks/dist/index.d.ts"
      ],
      "@openvtc/trust-tasks/*": [
        "../../node_modules/@openvtc/trust-tasks/dist/*.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/network-html/runtime/**/*",
    "src/network-ui/runtime/**/*"
  ]
}
