{
  "$comment": "Transcribes the real dtgwg-vsc-registry's predicate.jsonld shape (predicates/witnessed/1, predicates/endorses/1), not cred-spec issue #52's issue-body example — the registry now exists (undeployed) and is richer: it adds name/version, and id is a flat versioned path (.../vsc/<name>/<n>), not a #fragment. Required/optional split follows PR #47 'Predicate Profiles' (a profile MUST state these nine points) plus the two real registry entries' actual usage.",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "type", "name", "version", "status", "label", "definition", "classification", "objectKind", "taskContextRequired", "issuer", "establishes", "doesNotEstablish"],
  "properties": {
    "@context": { "type": "string" },
    "id": { "type": "string", "pattern": "^https://[^\\s#]+/[0-9]+$" },
    "type": { "const": "Predicate" },
    "name": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "proposed", "active", "deprecated"] },
    "since": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "label": { "type": "object", "required": ["en"], "additionalProperties": { "type": "string" } },
    "definition": { "type": "object", "required": ["en"], "additionalProperties": { "type": "string" } },
    "classification": { "enum": ["evidence", "assertion"] },
    "weighedBy": { "type": "string" },
    "objectKind": { "type": "array", "minItems": 1, "items": { "enum": ["id", "digestMultibase", "value"] } },
    "valueSchema": { "type": "string" },
    "subjectObjectRelationship": { "type": "string" },
    "additionalMembers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["required"],
        "properties": { "required": { "type": "boolean" }, "schema": { "type": "string" }, "description": { "type": "string" } }
      }
    },
    "taskContextRequired": { "type": "boolean" },
    "minimumIssuerScope": { "enum": ["pairwise", "directed", "public"] },
    "issuer": { "type": "string" },
    "establishes": { "type": "string" },
    "doesNotEstablish": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "definedIn": { "type": "string" },
    "governedBy": { "type": ["string", "null"] },
    "supersedes": { "type": ["string", "null"] },
    "supersededBy": { "type": ["string", "null"] }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "active" } } }, "then": { "required": ["since"] } },
    { "if": { "properties": { "objectKind": { "contains": { "const": "value" } } } }, "then": { "required": ["valueSchema"] } }
  ]
}
