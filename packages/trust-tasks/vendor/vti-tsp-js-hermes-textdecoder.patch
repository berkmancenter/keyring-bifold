diff -ruN a/src/cesr/utf8.ts b/src/cesr/utf8.ts
--- a/src/cesr/utf8.ts
+++ b/src/cesr/utf8.ts
@@ -0,0 +1,38 @@
+// Strict UTF-8 decoding that also runs on React Native's Hermes engine.
+//
+// `new TextDecoder("utf-8", { fatal: true })` is the right tool on Node and in
+// browsers: malformed input throws instead of decoding to U+FFFD, which is what
+// a VID field needs — a corrupted or hostile hop must not decode into a
+// plausible-looking identifier. Hermes implements `TextDecoder` without the
+// `fatal` option and throws at construction ("the 'fatal' option is
+// unsupported"), so a module that constructs one at load time cannot even be
+// imported there. Feature-detect once and fall back to a lenient decode checked
+// by re-encoding, which rejects exactly the same inputs.
+//
+// Keyring carries this as a local patch on top of the published package; the
+// upstream request is to take it as is.
+
+const utf8 = new TextEncoder();
+
+function bytesEqual(a: Uint8Array, b: Uint8Array): boolean {
+  if (a.length !== b.length) return false;
+  for (let i = 0; i < a.length; i++) if (a[i] !== b[i]) return false;
+  return true;
+}
+
+/** A `{ decode }` object with `TextDecoder`'s strict semantics on every runtime. */
+export function strictUtf8Decoder(): { decode(bytes: Uint8Array): string } {
+  try {
+    const decoder = new TextDecoder("utf-8", { fatal: true });
+    return { decode: (bytes) => decoder.decode(bytes) };
+  } catch {
+    const lenient = new TextDecoder("utf-8");
+    return {
+      decode: (bytes) => {
+        const text = lenient.decode(bytes);
+        if (!bytesEqual(utf8.encode(text), bytes)) throw new TypeError("invalid UTF-8");
+        return text;
+      },
+    };
+  }
+}
